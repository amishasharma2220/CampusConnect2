# ─── Database ───────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/campusconnect

# ─── Auth ───────────────────────────────────────────
JWT_SECRET_KEY=your-secret-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Backend ────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=development

# ─── Frontend ───────────────────────────────────────
VITE_API_BASE_URL=https://campusconnect-api-p6ql.onrender.com/api/v1

# ─── Cloudinary (image uploads) ─────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Razorpay (payments) ────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ─── Email ──────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Observability (Phase 6)
LOG_LEVEL=INFO
# json | text (empty = json in production/staging, text otherwise)
LOG_FORMAT=
# From sentry.io > Project Settings > Client Keys (DSN). Empty = disabled.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# Security (Phase 7)
# Browser origins allowed to call the API (comma-separated). FRONTEND_URL is added automatically.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://campus-connect2-alpha.vercel.app
# Email domains allowed to self-register (as students).
ALLOWED_SIGNUP_DOMAINS=muj.manipal.edu
